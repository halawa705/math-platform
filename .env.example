# ============================================================================
# إعدادات البيئة لمنصة الرياضيات المتكاملة (Math Platform)
# انسخ هذا الملف إلى .env.local عند التشغيل المحلي، أو أضف هذه المتغيرات في Vercel
# ============================================================================

# 1. إعدادات قاعدة البيانات والتخزين السحابي المجاني (Supabase - اختياري للربط السحابي)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# 2. رمز المعلم السري لبوابة الدخول الموحدة (الافتراضي: 19842026)
NEXT_PUBLIC_TEACHER_SECRET_PIN="19842026"

# 3. إعدادات التخزين السحابي للملفات والفيديوهات مستقبلاً (Cloudflare R2 / BunnyCDN)
NEXT_PUBLIC_STORAGE_PUBLIC_URL=""
